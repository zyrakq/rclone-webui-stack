# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=rclone-webui

# Docker image
IMAGE=rclone/rclone:latest

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

TZ=Etc/UTC

RCLONE_ADDR=":5572"
RCLONE_ALLOW_ORIGIN=*

RCLONE_USER=admin
RCLONE_PASS=lntuDaDrB1fTndJ5jIDcTQkrVppA9yJz

LOG_LEVEL=INFO
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=5572
VIRTUAL_HOST=rclone-webui.local

# Step CA SSL certificate domain
LETSENCRYPT_HOST=rclone-webui.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com